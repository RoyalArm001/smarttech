# cPanel server environment. Never commit real credentials.
NODE_ENV=production
PORT=3000
OPEN_BROWSER=0
# Public website reads the reviewed Git snapshot; Auth/profiles still use Supabase.
PUBLIC_CONTENT_SOURCE=repository
SMARTTECH_WEB_ORIGIN=https://smarttechllc.am
REQUEST_TRUSTED_HOSTS=smarttechllc.am,www.smarttechllc.am
# Set 1 only after confirming one trusted proxy hop with the host.
SMARTTECH_TRUST_PROXY=

# Existing Supabase project. Configure one server key below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMARTTECH_OWNER_EMAIL=
SMARTTECH_OWNER_USERNAME=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
REQUEST_EMAIL_FROM=
REQUEST_EMAIL_TO=
RESEND_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional existing Firebase browser metrics: public configuration only.
SMARTTECH_FIREBASE_DATABASE_URL=
SMARTTECH_FIREBASE_STATS_PATH=
SMARTTECH_FIREBASE_API_KEY=
# Blank uses same-origin APIs.
SMARTTECH_CMS_API_BASE_URL=
# Optional private writable directory, outside document root.
SMARTTECH_CMS_DATA_DIR=
