
# Copy to .env locally. Never commit .env to Git.

# --- Required for AI chat (server only, never in frontend) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Chat page (/chat) uses OpenAI ChatGPT; floating widget uses Gemini above ---
# Requires active billing on https://platform.openai.com/settings/billing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Form submissions (contact page, chat brief) -> support@ via cPanel SMTP ---
# Public site email shown to visitors: info@smarttechllc.am
# order@ sends API requests to support@
SMTP_HOST=mail.smarttechllc.am
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=order@smarttechllc.am
SMTP_PASS=";H^jIBFkNLeZ4J(}"
REQUEST_EMAIL_FROM=Smart Tech <order@smarttechllc.am>
REQUEST_EMAIL_TO=support@smarttechllc.am
REQUEST_TRUSTED_HOSTS=smarttechllc.am,www.smarttechllc.am

# Alternative: Resend API (recommended on Vercel — cPanel SMTP is often blocked there)
RESEND_API_KEY=

# --- Admin CMS (fully separate: cd admin && npm run dev) ---
# Public web (npm run dev in project root) does NOT expose /admin or /api/admin/*.
# CMS changes are published to src/content/published/site-snapshot.json for the web.
# If empty, the temporary default password is SmartTech@2026.
# Replace it before production.
SMARTTECH_ADMIN_PASSWORD=
ADMIN_PORT=3001
SMARTTECH_WEB_ORIGIN=http://localhost:3000
# Legacy combined mode (web + admin on one port): SMARTTECH_APP_MODE=all
SMARTTECH_CMS_ALLOWED_ORIGINS=https://smarttechllc.am,https://www.smarttechllc.am
SMARTTECH_CMS_API_BASE_URL=
# Optional for standalone backend with persistent storage:
# SMARTTECH_CMS_DATA_DIR=
# SMARTTECH_CMS_UPLOAD_DIR=

# --- Firebase visit counter (use SMARTTECH_* names; enough for this project) ---
SMARTTECH_FIREBASE_DATABASE_URL=
SMARTTECH_FIREBASE_STATS_PATH=
SMARTTECH_FIREBASE_API_KEY=
# Optional only if Firebase rules require a fixed token:
# SMARTTECH_FIREBASE_AUTH_TOKEN=

# VITE_* names also work as fallbacks during build, but SMARTTECH_* is preferred.
# You do NOT need VITE_FIREBASE_AUTH_DOMAIN, PROJECT_ID, STORAGE_BUCKET, etc.
# This site only uses database URL, stats path and API key for the visit counter.

# --- Vercel (Project Settings → Environment Variables) ---
# Required for floating quick chat (Gemini):
#   GEMINI_API_KEY
# Required for /chat page (OpenAI ChatGPT):
#   OPENAI_API_KEY
# Required for chat brief email via cPanel:
#   SMTP_HOST, SMTP_USER, SMTP_PASS, REQUEST_EMAIL_TO, REQUEST_EMAIL_FROM
# Optional:
#   REQUEST_TRUSTED_HOSTS=smarttechllc.am,www.smarttechllc.am
# Security: keep SMTP_PASS and API keys only in .env / Vercel Secrets, never in git.
# Or use Resend instead:
#   RESEND_API_KEY
#   SMARTTECH_ADMIN_PASSWORD          (admin login; CMS writes are not persistent on Vercel)
#   SMARTTECH_FIREBASE_*              (visit counter; also read at build time for dist/)
# Note: This is NOT a Next.js app. Do not add @vercel/analytics/next or speed-insights/next.
# Note: Some Vercel plans block outbound SMTP. If email fails on Vercel, use Resend or SMTP on your cPanel host.
