{
  "name": "smarttech-site",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node tools/start-local.js",
    "dev": "node tools/start-local.js",
    "local": "node tools/start-local.js",
    "preview": "node tools/start-local.js",
    "serve": "node server.js",
    "web": "npm run build",
    "seo": "node lib/apply-seo.js",
    "build": "npm run check && node lib/build-static.js",
    "vercel-build": "npm run check && node lib/build-static.js",
    "sync:pages": "node -e \"require('fs').cpSync('pages','lib/page-templates',{recursive:true,force:true}); console.log('Synced pages/ -> lib/page-templates/')\"",
    "check": "node lib/check-syntax.js",
    "test:smtp": "node lib/test-smtp.js",
    "lint": "echo \"No linting configured. Add ESLint or a linter if needed.\""
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "node-domexception": "file:vendor/node-domexception"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@supabase/supabase-js": "^2.55.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "nodemailer": "^9.1.1",
    "openai": "^6.42.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "@google/genai": true,
    "protobufjs": true,
    "sharp": true
  }
}
