# Keep the actual .env outside Git; do not paste credentials into chat.
# Export-only source credentials. Never use these in the new runtime backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=
# Direct PostgreSQL connection plus pg_dump matching the source major version.
PG_DUMP_PATH=
PG_DUMPALL_PATH=
PG_SSL_CA_FILE=

# Dedicated, empty destination for rehearsal; never an existing production schema.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_CA_FILE=

# Existing parent directory, outside the checkout and outside any public web root.
BACKUP_KEY_FILE=
PRIVATE_STORAGE_ROOT=
NODE_ENV=production
PORT=3000
APP_ORIGIN=
